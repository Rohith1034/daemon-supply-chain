FROM python:3.13-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

RUN groupadd --system --gid 50000 app \
    && useradd --system --uid 50000 --gid app --create-home app

COPY --chown=50000:50000 api ./api
COPY --chown=50000:50000 simulator ./simulator

ENV PYTHONPATH=/app:/app/simulator

RUN mkdir -p /app/output && chown -R 50000:50000 /app

USER 50000:50000

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
