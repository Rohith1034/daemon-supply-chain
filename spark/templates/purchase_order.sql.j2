SELECT
  purchaseOrder.poId AS po_id,

  -- Event Information
  eventType AS event_type,
  occurredAt AS occurred_at,

  -- Purchase Order
  purchaseOrder.status AS status,
  purchaseOrder.orderDate AS order_date,
  purchaseOrder.expectedDelivery AS expected_delivery,

  -- Supplier
  purchaseOrder.supplierId AS supplier_id,
  purchaseOrder.supplierName AS supplier_name,

  -- Warehouse
  purchaseOrder.warehouseId AS warehouse_id,
  purchaseOrder.warehouseName AS warehouse_name,

  -- Financial
  purchaseOrder.currency AS currency,
  purchaseOrder.totalItems AS total_items,
  purchaseOrder.totalQuantity AS total_quantity,
  purchaseOrder.totalAmount AS total_amount,

  -- Purchase Order Items
  purchaseOrder.items AS items,

  -- Approval Information
  approved_at,
  approved_by,

  -- Metadata
  correlation_id,
  CURRENT_TIMESTAMP AS silver_load_timestamp
FROM source_dataframe
WHERE
  eventType IN (
    'PurchaseOrderCreated',
    'PurchaseOrderApproved'
  )
